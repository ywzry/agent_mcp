{
  "name": "agent-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Multi-model coding agent MCP plugin with sessions, browser and Windows desktop tools",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "setup:desktop": "npm run build && node scripts/setup-desktop.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "chrome-devtools-mcp": "1.9.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
